# Deployment-host variables for docker-compose.staging-server.yml.
# Keep the populated file on the staging server; never commit it as .env.staging.
POSTGRES_USER_STAGING=sales_staging
POSTGRES_PASSWORD_STAGING=change-me
POSTGRES_DB_STAGING=salesdb_staging
JWT_SECRET_STAGING=replace-with-a-random-secret-at-least-32-characters
AUTH_COOKIE_SECURE_STAGING=false
DATABASE_URL_STAGING=postgres://sales_staging:change-me@postgres:5432/salesdb_staging?sslmode=disable
LEADGEN_BACKEND_URL_STAGING=http://202.50.203.136:3100
